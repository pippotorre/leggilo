{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# API di Kavita: stesso indirizzo dell'app.
	# Anche la versione pubblica di Leggilo (e l'app degli store) può usarle: CORS solo per quell'origine.
	@pubblica header Origin {$ORIGINE_PUBBLICA:https://leggilo.entratadisicurezza.com}
	handle /api/* {
		@preflight {
			method OPTIONS
			header Origin {$ORIGINE_PUBBLICA:https://leggilo.entratadisicurezza.com}
		}
		header @pubblica {
			Access-Control-Allow-Origin "{$ORIGINE_PUBBLICA:https://leggilo.entratadisicurezza.com}"
			Access-Control-Allow-Headers "Authorization, Content-Type"
			Access-Control-Allow-Methods "GET, POST, OPTIONS"
			Access-Control-Max-Age "86400"
			Vary Origin
		}
		respond @preflight 204
		reverse_proxy {$KAVITA_URL:http://kavita:5000}
	}

	handle {
		root * /srv
		# Il service worker e il manifest non vanno tenuti in cache dal browser
		@nocache path /sw.js /registerSW.js /manifest.webmanifest /index.html /
		header @nocache Cache-Control "no-cache"
		@asset path /assets/*
		header @asset Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
}
